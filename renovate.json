{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests",
        ":configMigration",
        "abandonments:recommended",
        ":maintainLockFilesWeekly",
        ":enableVulnerabilityAlerts",
        ":semanticCommits",
        ":semanticCommitScope(deps)"
    ],
    "timezone": "Europe/London",
    "prConcurrentLimit": 5,
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update the Renovate configuration validator that CI uses",
            "managerFilePatterns": [
                "/^\\.github/workflows/ci\\.yml$/"
            ],
            "matchStrings": [
                "npx --yes --package renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+) -- renovate-config-validator --strict"
            ],
            "depNameTemplate": "renovate",
            "datasourceTemplate": "npm",
            "versioningTemplate": "npm"
        }
    ],
    "packageRules": [
        {
            "description": "Keep TypeScript at version 6 until Astro Check supports the native compiler API",
            "matchManagers": [
                "npm"
            ],
            "matchPackageNames": [
                "typescript"
            ],
            "allowedVersions": "<7"
        },
        {
            "description": "Group non-major Composer development dependency updates",
            "matchManagers": [
                "composer"
            ],
            "matchDepTypes": [
                "require-dev"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "Composer development dependencies (non-major)"
        }
    ]
}
