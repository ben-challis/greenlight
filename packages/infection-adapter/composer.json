{
    "name": "greenlight/infection-adapter",
    "description": "Infection test framework adapter for Greenlight",
    "license": "MIT",
    "type": "infection-extension",
    "require": {
        "php": ">=8.4",
        "greenlight/greenlight": "dev-main || ^0.1",
        "infection/abstract-testframework-adapter": "^0.5.0",
        "infection/include-interceptor": "^1.0.0"
    },
    "autoload": {
        "psr-4": {
            "Greenlight\\InfectionAdapter\\": "src/"
        }
    },
    "bin": [
        "bin/greenlight-infection"
    ],
    "extra": {
        "infection": {
            "class": "Greenlight\\InfectionAdapter\\GreenlightAdapterFactory"
        }
    },
    "config": {
        "sort-packages": true
    }
}
