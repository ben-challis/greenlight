{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "id": "https://raw.githubusercontent.com/ben-challis/greenlight/main/resources/schema/test-coverage-jsonl-v1.schema.json",
    "title": "Greenlight per-test coverage artifact record (v1)",
    "description": "One line of Greenlight's opt-in per-test coverage artifact. Version 1 is additive: consumers must tolerate unknown keys and may skip unknown record types.",
    "type": "object",
    "required": ["v", "type"],
    "properties": {
        "v": {"enum": [1]},
        "type": {"type": "string", "minLength": 1}
    },
    "oneOf": [
        {
            "properties": {
                "type": {"enum": ["meta"]},
                "root": {"type": "string", "minLength": 1},
                "runId": {"type": "string", "minLength": 1},
                "complete": {"enum": [true]}
            },
            "required": ["root", "runId", "complete"]
        },
        {
            "properties": {
                "type": {"enum": ["test"]},
                "test": {"type": "integer", "minimum": 0},
                "id": {"$ref": "#/definitions/testId"},
                "renderedId": {"type": "string", "minLength": 1},
                "file": {"type": "string"}
            },
            "required": ["test", "id", "renderedId", "file"]
        },
        {
            "properties": {
                "type": {"enum": ["coverage"]},
                "test": {"type": "integer", "minimum": 0},
                "file": {"type": "string", "minLength": 1},
                "lines": {"$ref": "#/definitions/lines"}
            },
            "required": ["test", "file", "lines"]
        },
        {
            "properties": {
                "type": {"enum": ["source"]},
                "file": {"type": "string", "minLength": 1},
                "covered": {"type": "boolean"},
                "lines": {"$ref": "#/definitions/lines"}
            },
            "required": ["file", "covered", "lines"]
        },
        {
            "properties": {
                "type": {"enum": ["unattributed"]},
                "file": {"type": "string", "minLength": 1},
                "lines": {"$ref": "#/definitions/lines"}
            },
            "required": ["file", "lines"]
        }
    ],
    "definitions": {
        "lines": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1}
        },
        "testId": {
            "type": "object",
            "required": ["class", "method", "dataSetKey"],
            "properties": {
                "class": {"type": "string", "minLength": 1},
                "method": {"type": "string", "minLength": 1},
                "dataSetKey": {"type": ["string", "null"]}
            }
        }
    }
}
