includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - extension.neon

parameters:
    level: max
    checkBenevolentUnionTypes: true
    checkMissingCallableSignature: true
    reportIgnoresWithoutComments: true
    treatPhpDocTypesAsCertain: false
    tmpDir: build/cache/phpstan
    exceptions:
        checkedExceptionClasses:
            - Greenlight\Capture\CaptureError
            - Greenlight\Cli\CliError
            - Greenlight\Config\ConfigFileError
            - Greenlight\Config\InvalidConfiguration
            - Greenlight\Artifact\AttachmentError
            - Greenlight\Internal\Filesystem\AtomicFileError
            - Greenlight\Test\SkipTest
            - Greenlight\Wire\WireCommunicationFailed
            - Greenlight\Coverage\CoverageError
            - Greenlight\Discovery\DiscoveryError
            - Greenlight\Doubles\InvalidDoubleUsage
            - Greenlight\Expect\ExpectationFailed
            - Greenlight\Sandbox\TemporaryDirectoryError
            - Greenlight\Harness\ServiceResolutionFailed
            - Greenlight\PhpStan\MatcherMapError
            - Greenlight\Reporting\ReportGenerationFailed
            - Greenlight\IntegrationFixture\IntegrationFixtureError
            - Greenlight\Runner\Worker\WorkerError
        check:
            missingCheckedExceptionInThrows: true
            throwTypeCovariance: true
            tooWideThrowType: true
    paths:
        - src
        - tests
        - tools
        - bin/greenlight
        - greenlight.php
        - greenlight.coverage.php
        - greenlight.tempest-coverage.php
        - rector.php
        - rector.docs.php
    scanFiles:
        - stubs/tempest.stub.php
        - tools/phpstan-stubs/hyperf.php
    excludePaths:
        analyse:
            - tests/Fixture/DataRowsDuplicateInline
            - tests/Fixture/DataRowsInvalid/EmptyDataRowLabelTest.php
            - tests/Fixture/DiscoveryAttributeArgumentsInvalid
            - tests/Fixture/DiscoveryGroupInvalid
            - tests/Fixture/DiscoveryInvalidMethods
            - tests/Fixture/DiscoveryResourceInvalid
    greenlight:
        configFiles:
            - tests/Fixture/PhpStanExtension/greenlight.php
            - tests/Fixture/PhpStanExtension/even-numbers.php

services:
    exceptionTypeResolver!:
        class: Greenlight\Tests\Support\TestCodeExceptionTypeResolver
