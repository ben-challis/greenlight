includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - extension.neon

parameters:
    level: max
    tmpDir: build/cache/phpstan
    scanFiles:
        - packages/infection-adapter/src/CoverageXmlWriter.php
    paths:
        - src
        - tests
        - tools
    excludePaths:
        analyse:
            - tests/Fixture/DataRowsDuplicateInline
            - tests/Fixture/DiscoveryAttributeArgumentsInvalid
            - tests/Fixture/DiscoveryGroupInvalid
            - tests/Fixture/DiscoveryInvalidMethods
            - tests/Fixture/DiscoveryResourceInvalid
    greenlight:
        configFiles:
            - tests/Fixture/PhpStanExtension/greenlight.php
