---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';

import DocsLayout from '../../layouts/DocsLayout.astro';
import { assertCompleteDocCollection, docById } from '../../lib/docs';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  assertCompleteDocCollection(entries);

  return entries.map((entry) => {
    const id = entry.id.replace(/\.md$/, '');

    return {
      params: { slug: id },
      props: { entry, id },
    };
  });
}

interface Props {
  entry: CollectionEntry<'guides'>;
  id: string;
}

const { entry, id } = Astro.props;
const doc = docById(id);
const { Content, headings } = await render(entry);
---

<DocsLayout doc={doc} headings={headings}>
  <Content />
</DocsLayout>
