#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Greenlight;

// @phpstan-ignore smaller.alwaysFalse (The executable validates the PHP version at run time before it loads Composer.)
if (\PHP_VERSION_ID < 80400) {
    \fwrite(\STDERR, \sprintf(
        "Greenlight requires PHP 8.4 or later. The current PHP version is %s.\n",
        \PHP_VERSION,
    ));

    exit(1);
}

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaderFound = false;

foreach ($autoloaders as $autoloader) {
    if (\is_file($autoloader)) {
        require $autoloader;
        $autoloaderFound = true;

        break;
    }
}

if (!$autoloaderFound) {
    \fwrite(\STDERR, "Could not locate the Composer autoloader. Run \"composer install\" first.\n");

    exit(1);
}

$workingDirectory = \getcwd();

if ($workingDirectory === false) {
    \fwrite(\STDERR, "Could not determine the current working directory.\n");

    exit(1);
}

/** @var list<string> $arguments */
$arguments = [];
$serverArguments = $_SERVER['argv'] ?? [];

if (\is_array($serverArguments)) {
    foreach (\array_slice($serverArguments, 1) as $argument) {
        if (\is_string($argument)) {
            $arguments[] = $argument;
        }
    }
}

exit(\Greenlight\Cli\Application::forStreams()->run($arguments, $workingDirectory, __FILE__));
