{
    "name": "greenlight/hyperf-bridge-acceptance",
    "description": "Exercises the Greenlight bridge against a real Hyperf runtime.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../..",
            "options": {
                "symlink": false
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-swoole": "*",
        "greenlight/greenlight": "@dev",
        "hyperf/command": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/di": "~3.2.0",
        "hyperf/framework": "~3.2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HyperfBridgeAcceptance\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
